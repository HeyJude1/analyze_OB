    {
      "pattern_type": "core.mm_microkernel",
      "name": "矩阵乘法微内核",
      "description": "实现矩阵乘法的微内核，通过三层嵌套循环对每个输出元素执行点积计算，内层循环使用累加操作 C[i][j] += A[i][k] * B[k][j]，符合寄存器级FMA展开特征，虽未显式使用SIMD，但结构上为微内核的纯解释形式。",
      "code": "for i in range(M):      # 遍历A的每一行\n        for j in range(N):  # 遍历B的每一列\n            for k in range(K): # 遍历A的列和B的行\n                C[i][j] += A[i][k] * B[k][j]",
      "data_object_features": {
        "numeric_kind": "实数",
        "numeric_precision": "N/A",
        "structural_properties": "通用",
        "storage_layout": "连续"
      }
