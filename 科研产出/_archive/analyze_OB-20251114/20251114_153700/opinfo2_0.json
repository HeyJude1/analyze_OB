    {
      "pattern_type": "prep.index_pointer_init",
      "name": "索引与指针初始化",
      "description": "初始化循环变量M、K、N分别表示矩阵A的行数、列数和矩阵B的列数；初始化结果矩阵C为M×N的零矩阵，用于累加乘积结果。",
      "code": "M = len(A)\nK = len(A[0])\nN = len(B[0])\n\nC = [[0 for _ in range(N)] for _ in range(M)]",
      "data_object_features": {
        "numeric_kind": "N/A",
        "numeric_precision": "N/A",
        "structural_properties": "N/A",
        "storage_layout": "N/A"
      }
