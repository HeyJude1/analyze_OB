      "pattern_type": "prep.parameter_validation",
      "name": "参数合法性校验",
      "description": "检查 M 和 N 是否为零，若为零则提前返回；检查 alpha 是否为 0.0f，若为零则清零 B 矩阵并返回。",
      "code": "if (M == 0 || N == 0) {\n        return;\n    }\n\n    // 如果 alpha 为 0，则将 B 矩阵清零并返回。\n    if (alpha == 0.0f) {\n        for (int j = 0; j < N; ++j) {\n            for (int i = 0; i < M; ++i) {\n                B(i, j) = 0.0f;\n            }\n        }\n        return;\n    }",
