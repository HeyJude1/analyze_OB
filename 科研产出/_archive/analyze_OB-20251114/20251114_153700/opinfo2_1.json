      "pattern_type": "prep.loop_invariant_calc",
      "name": "循环不变量计算",
      "description": "在循环外定义分块大小常量 MC、KC、NC，用于后续分块循环中控制块尺寸，避免在循环内重复计算。",
      "code": "const int MC = 256; // 块大小 M-dimension\n    const int KC = 128; // 块大小 K-dimension\n    const int NC = 4096; // 块大小 N-dimension",
      "data_object_features": {
        "numeric_kind": "实数",
        "numeric_precision": "N/A",
        "structural_properties": "N/A",
        "storage_layout": "N/A"
      }
    },
    {
      "pattern_type": "core.tiled_loop",
      "name": "分块矩阵处理循环",
      "description": "使用三层嵌套循环（j, p, i）遍历矩阵B和A的分块，外层j控制N方向块，p控制K方向块，内层i控制M方向块，每层块大小由MC/KC/NC定义，用于驱动微内核执行以优化缓存复用。",
      "code": "for (int j = 0; j < N; j += NC) {\n        int nc = min(N - j, NC);\n\n        for (int p = 0; p < M; p += KC) {\n            int kc = min(M - p, KC);\n\n            pack_matrix_B(nc, kc, &B(p, j), ldb, packed_b);\n\n            for (int i = p; i < M; i += MC) {\n                int mc = min(M - i, MC);\n                \n                pack_matrix_A(mc, kc, &A(i, p), lda, packed_a);\n\n                gemm_micro_kernel(mc, nc, kc, 1.0f, packed_a, &B(i, j), ldb);\n            }\n        }\n    }",
      "data_object_features": {
        "numeric_kind": "实数",
        "numeric_precision": "单精度",
        "structural_properties": "通用",
        "storage_layout": "跨步"
      }
    },
    {
      "pattern_type": "core.mm_microkernel",
      "name": "矩阵乘法微内核",
      "description": "调用 gemm_micro_kernel 函数执行 mc x nc x kc 的小规模矩阵乘法 C += A * B，参数中包含块大小和打包后的连续数据，符合寄存器级FMA微内核的调用模式，尽管实现简化，但作为核心计算单元被显式调用。",
      "code": "gemm_micro_kernel(mc, nc, kc, 1.0f, packed_a, &B(i, j), ldb);",
      "data_object_features": {
        "numeric_kind": "实数",
        "numeric_precision": "单精度",
        "structural_properties": "通用",
        "storage_layout": "连续"
      }
    },
    {
      "pattern_type": "post.scale_accumulation",
      "name": "结果缩放与累加",
      "description": "根据实际代码生成具体描述，说明如何进行结果缩放和累加、涉及的系数处理和写回方式。识别标准，C=alpha*Temp + beta*C 写回；包含 alpha/beta 分支与目标内存写回。",
