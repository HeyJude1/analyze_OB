      "pattern_type": "core.tiled_loop",
      "name": "分块矩阵处理循环",
      "description": "使用三层嵌套循环（j, p, i）遍历矩阵分块，外层遍历N方向块，中层遍历K方向块，内层遍历M方向块，驱动微内核进行矩阵乘法计算，以优化缓存复用。",
      "code": "for (int j = 0; j < N; j += NC) {\n        int nc = min(N - j, NC);\n\n        for (int p = 0; p < M; p += KC) {\n            int kc = min(M - p, KC);\n\n            pack_matrix_B(nc, kc, &B(p, j), ldb, packed_b);\n\n            for (int i = p; i < M; i += MC) {\n                int mc = min(M - i, MC);\n                \n                pack_matrix_A(mc, kc, &A(i, p), lda, packed_a);\n\n                gemm_micro_kernel(mc, nc, kc, 1.0f, packed_a, &B(i, j), ldb);\n            }\n        }\n    }",
      "data_object_features": {
        "numeric_kind": "实数",
        "numeric_precision": "单精度",
        "structural_properties": "通用",
        "storage_layout": "跨步"
      }
    },
    {
      "pattern_type": "core.mm_microkernel",
      "name": "矩阵乘法微内核",
      "description": "实现矩阵乘法微内核，通过三重循环对小块矩阵进行累加计算，使用pack_a和B的子块进行乘加操作，符合寄存器级FMA展开模式，虽为简化版本但结构完整。",
      "code": "void gemm_micro_kernel(int mc, int nc, int kc, float alpha, float *pack_a, float *c, int ldc) {\n    for (int j = 0; j < nc; ++j) {\n        for (int i = 0; i < mc; ++i) {\n            for (int p = 0; p < kc; ++p) {\n                c[j * ldc + i] += pack_a[p * mc + i] * B(p,j);\n            }\n        }\n    }\n}",
      "data_object_features": {
        "numeric_kind": "实数",
        "numeric_precision": "单精度",
        "structural_properties": "通用",
        "storage_layout": "连续"
      }
