              {
                "default": 4,
                "name": "REG_BLOCK_M",
                "source": "derived:isa_defaults",
                "type": "int"
              },
              {
                "default": 8,
                "name": "REG_BLOCK_N",
                "source": "par:reg_block_n",
                "type": "int"
              },
              {
                "default": "_mm256_setzero_pd()",
                "name": "INIT",
                "source": "operator.init",
                "type": "code"
              }
            ],
            "check_hints": [
              "AVX2 只有 16 个 ymm：累加器 + A/B 向量不能超过它",
