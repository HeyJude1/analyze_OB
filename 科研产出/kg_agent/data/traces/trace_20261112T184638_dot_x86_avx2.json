            "language": "c",
            "skeleton": "/* 寄存器分块：{{REG_BLOCK_M}}x{{REG_BLOCK_N}} 个输出块常驻 ymm 累加器 */\nfor (j = 0; j < bn; j += {{REG_BLOCK_N}}) {\n    __m256d acc[{{REG_BLOCK_M}}][{{REG_BLOCK_N}}/4] = {{INIT}};\n    for (k = 0; k < bk; k++) {\n        /* 每步装入 A 的 {{REG_BLOCK_M}} 个标量 + B 的 {{REG_BLOCK_N}} 个向量，做 {{REG_BLOCK_M}}x{{REG_BLOCK_N}} 次 FMA */\n    }\n    /* 写回 {{REG_BLOCK_N}} 列 C */\n}",
