{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kg_agent/schema/node.schema.json",
  "title": "kg_agent node (Schema v1.5)",
  "type": "object",
  "required": ["id", "type", "name", "properties", "provenance"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*:[A-Za-z0-9_.:/-]+$",
      "description": "{prefix}:{slug}，发布后不可变"
    },
    "type": {
      "type": "string",
      "enum": [
        "Operator",
        "ComputationPattern",
        "CodeCharacteristic",
        "OptimizationStrategy",
        "ImplementationTemplate",
        "TunableParameter",
        "ISACapability",
        "Microarchitecture",
        "HardwareProfile",
        "PerformanceEvidence",
        "SourceArtifact",
        "FailureCase"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "properties": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["source_file", "extractor_version"],
      "additionalProperties": true,
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "line_start": {"type": ["integer", "null"], "minimum": 0},
        "line_end": {"type": ["integer", "null"], "minimum": 0},
        "line_confidence": {"type": "string", "enum": ["exact", "approx"]},
        "commit": {"type": ["string", "null"]},
        "repo": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "extractor_version": {"type": "string", "minLength": 1}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
